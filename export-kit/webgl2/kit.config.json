{
  "configVersion": 1,
  "id": "webgl2",
  "series": "0.1",
  "shaderSource": "runtime",
  "engineSource": "cdn",
  "shaderDialects": ["glsl"],
  "pageTemplate": true,
  "requiredTokens": {
    "index.template.html": ["NM_PROGRAM_NAME_HTML", "NM_PROGRAM_NAME_JSON", "NM_ENGINE_VERSION"],
    "README.template.md": ["NM_PROGRAM_NAME", "NM_EFFECT_LIST", "NM_ENGINE_VERSION"]
  },
  "shaderLayout": {
    "root": "shaders"
  },
  "inject": {
    "type": "dsl-json-template",
    "target": "index.html"
  },
  "compat": {
    "mode": "all"
  },
  "engineBytesFrom": null
}
